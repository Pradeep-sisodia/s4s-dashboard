{
  "name": "s4s-dashboard-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "build": "npm install --prefix ../client && npm run build --prefix ../client",
    "start": "node index.js",
    "sync": "node --input-type=module -e \"import { ensureFreshData } from './data.js'; const r=await ensureFreshData(true); console.log(r); process.exit(0);\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10"
  }
}
